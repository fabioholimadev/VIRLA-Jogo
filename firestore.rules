rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.presenter == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'fabiooliveiral2020@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['googleId', 'nickname', 'characterIndex']) &&
             data.keys().hasOnly(['googleId', 'email', 'nickname', 'characterIndex', 'createdAt', 'updatedAt']) &&
             data.googleId is string && data.googleId.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 16 &&
             data.characterIndex is number && data.characterIndex >= 0 && data.characterIndex <= 2 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256));
    }

    function isValidGameSession(data) {
      return data.keys().hasAll(['pin', 'googleId', 'nickname', 'score', 'rescuedCount']) &&
             data.keys().hasOnly(['pin', 'googleId', 'nickname', 'characterIndex', 'score', 'rescuedCount', 'recoveries', 'finishedAt']) &&
             data.pin is string && data.pin.size() <= 16 &&
             data.googleId is string && data.googleId.size() <= 128 &&
             data.nickname is string && data.nickname.size() <= 16 &&
             data.score is number && data.score >= 0 &&
             data.rescuedCount is number && data.rescuedCount >= 0;
    }

    // User profiles: only owner can read and write their profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.googleId == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data) && request.resource.data.googleId == resource.data.googleId;
      allow delete: if isAdmin();
    }

    // Game results: participants can save their final score
    match /game_results/{resultId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resultId) && isValidGameSession(request.resource.data) && request.resource.data.googleId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
